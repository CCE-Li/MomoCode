ENVIRONMENT=staging
DEBUG=false

POSTGRES_DB=momocode
POSTGRES_USER=momocode
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

DATABASE_URL=postgresql+asyncpg://momocode:CHANGE_ME_DB_PASSWORD@db:5432/momocode
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=["http://localhost:8080"]
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHARS
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO

APP_BASE_URL=https://momo.example.com
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=no-reply@momo.example.com
SMTP_USE_TLS=true

# 自动判题需要独立 judge worker；未配置时编码任务返回“未判题”。
JUDGE_DOCKER_IMAGE=momocode-judge:latest
JUDGE_TIMEOUT_SECONDS=20
JUDGE_MEMORY_MB=256

# AI 判题（OpenAI 兼容接口），不配置则 AI 判题不可用。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

WEB_PORT=8080
